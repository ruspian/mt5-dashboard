# Copy file ini jadi .env.local (jangan commit .env.local ke git)
#
# Kredensial bridge disimpan di SINI (server), bukan lagi di browser.
# Diisi SEKALI saat deploy, semua device yang login dengan password
# di bawah otomatis bisa akses dashboard tanpa perlu isi ulang.

# URL bridge Python lo di VPS (harus HTTPS)
BRIDGE_URL=https://bridge.domainlo.com

# Token API dari bridge/config.py (API_TOKEN)
BRIDGE_TOKEN=isi_token_dari_config_py_di_bridge

# Password untuk login ke dashboard ini (bebas tentuin sendiri, minimal 8 karakter)
DASHBOARD_PASSWORD=ganti_dengan_password_lo

# Secret untuk menandatangani session cookie (WAJIB diganti, string acak panjang)
# generate dengan: openssl rand -base64 32
SESSION_SECRET=ganti_dengan_string_acak_panjang

# Catatan: FINNHUB_API_KEY (untuk fitur News Engine) diisi di
# bridge/config.py, BUKAN di sini — karena yang fetch berita adalah
# bridge Python, bukan webapp ini.
